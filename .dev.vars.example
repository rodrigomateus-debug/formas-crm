# Copiar a .dev.vars para desarrollo local.
DEV_USER_EMAIL=rodrigo.mateus@formaspublicitarias.com
# Opcional, para probar Gmail (o generar uno de prueba con `node test/gmail-dev-vars.mjs`):
# GOOGLE_SA_JSON='{"client_email":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…"}'
# Pruebas de pedidos (test/pedidos.test.mjs): ClickUp y Finnegans simulados en el puerto 8797.
CLICKUP_TOKEN=prueba
CLICKUP_API_URL=http://localhost:8797/clickup
FINNEGANS_CLIENT_ID=prueba
FINNEGANS_CLIENT_SECRET=prueba
FINNEGANS_API_URL=http://localhost:8797/fin
# Prueba de datos para facturar (test/facturar.test.mjs): la lista de empresas grandes de ARCA, simulada.
ARCA_FCE_URL=http://localhost:8796/fce
# Lectura de remitos (test/remitos.test.mjs): Claude simulado en el mismo puerto.
ANTHROPIC_API_KEY=prueba
ANTHROPIC_BASE_URL=http://localhost:8797/anthropic
# Direcciones de entrega (test/direcciones.test.mjs): Google Maps simulado en el puerto 8793.
GOOGLE_MAPS_API_KEY=prueba
GOOGLE_PLACES_API_URL=http://localhost:8793/places
# Login con Google (test/login.test.mjs): Google simulado en el puerto 8795.
GOOGLE_OAUTH_CLIENT_ID=prueba-login.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=prueba
SESSION_SECRET=clave-de-prueba-para-firmar-la-sesion
GOOGLE_OAUTH_TOKEN_URL=http://localhost:8795/google/token
