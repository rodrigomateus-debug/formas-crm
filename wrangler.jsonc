{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formas-crm",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hubspot/*", "/crm/*", "/oauth/*", "/hooks/*", "/mcp", "/mcp/*", "/health", "/contacts/*/record/*", "/login", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formas-crm",
      // Se completa con el id que devuelve `npx wrangler d1 create formas-crm` (ver README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "cold-mud-48f2.cloudflareaccess.com",
    // «Application Audience (AUD) Tag» de la aplicación de Access del CRM. No es secreto: va en cada redirección al login.
    "ACCESS_AUD": "aebdd096c8e7d18c6983122bb647d7f371a3388cbfe9eaf74ac4442a46df1a24",
    "ADMIN_EMAIL": "rodrigo.mateus@formaspublicitarias.com"
  },
  // :00, :10… ClickUp y Finnegans; :05, :15… Gmail (cada corrida tiene su propio tope de consultas). Ver index.ts.
  "triggers": { "crons": ["*/10 * * * *", "5-59/10 * * * *"] },
  // La base D1 no tiene región en Sudamérica: con Smart Placement el Worker corre al lado de la base y cada pantalla
  // hace un solo viaje largo (navegador → Worker) en vez de uno por consulta.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
