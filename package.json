{
  "name": "formas-crm",
  "version": "1.0.0",
  "description": "CRM propio de Formas Publicitarias (reemplazo de HubSpot)",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "dev:chofer": "vite -c vite.chofer.config.ts",
    "build": "vite build && vite build -c vite.chofer.config.ts",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply formas-crm --local",
    "db:remote": "wrangler d1 migrations apply formas-crm --remote",
    "deploy": "npm run build && wrangler d1 migrations apply formas-crm --remote && wrangler deploy",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "migrate:hubspot": "node scripts/migrate-hubspot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@types/leaflet": "^1.9.22",
    "hono": "^4.13.14",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "type": "module"
}
